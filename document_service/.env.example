# Core service
DOCUMENT_SERVICE_PORT=5710
DATABASE_URL=postgresql+psycopg://document:document@document-postgres:5432/document_service
REDIS_URL=redis://document-redis:6379/0

# Fina Demo deployment usually overrides DATABASE_URL with Aliyun PostgreSQL:
# DATABASE_URL=postgresql+psycopg://<user>:<url-encoded-password>@<aliyun-pg-host>:5432/postgres

# S3-compatible object storage. For local compose, these point at MinIO.
OBJECT_STORAGE_ENDPOINT=http://document-minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=documents
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=minio123
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# For URL-based cloud engines in Fina Demo, override object storage with TOS:
# OBJECT_STORAGE_ENDPOINT=https://tos-s3-cn-beijing.volces.com
# OBJECT_STORAGE_REGION=cn-beijing
# OBJECT_STORAGE_BUCKET=finademo
# OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Optional external/public host used to rewrite generated presigned URLs.
# Required when cloud engines must fetch files from a public HTTPS endpoint.
PUBLIC_PRESIGN_BASE_URL=
PRESIGNED_URL_TTL_SECONDS=3600

# Remote engines. Missing credentials make the engine unavailable.
DATALAB_API_KEY=
DATALAB_BASE_URL=https://www.datalab.to

MINERU_TOKEN=
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm

TEXTIN_APP_ID=
TEXTIN_SECRET_CODE=
TEXTIN_BASE_URL=https://api.textin.com

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.5-ocr

PADDLEOCR_API_URL=
PADDLEOCR_TOKEN=
PADDLEOCR_MODEL=PaddleOCR-VL-1.6

# Local preprocessing. Renders Word documents to PDF before sending them to engines.
LOCAL_DOCX_TO_PDF_ENABLED=true
LIBREOFFICE_BINARY=soffice
