{
  "metric_name": "retailcdp_high_churn_customers",
  "display_name": "Retail CDP High Churn Risk Customers",
  "domain": "quality_and_risk",
  "source_type": "cdp_postgres",
  "description": "Count of customer profiles with churn_risk_score >= 0.7. Lower is better; use for retention prioritization.",
  "data_type": "integer",
  "format": "0,0",
  "default_time_context": {
    "time_dimension": "created_at",
