# ── Master PostgreSQL / Aliyun RDS (stores datasource configs & metrics meta) ─
SPRING_DATASOURCE_URL=jdbc:postgresql://pgm-uf615169n98t95tflo.pg.rds.aliyuncs.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres_fuli
SPRING_DATASOURCE_PASSWORD=jfd4whz@GPF2nqx7zhm
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Connection pool sizing
MASTER_POOL_MAX=10
MASTER_POOL_MIN=2

# ── Dynamic SAP B1 HANA datasources ──────────────────────────────────────────
# These are managed at runtime via the API (POST /api/v1/datasources).
# HANA passwords stored in t_datasource_config are AES-encrypted with ENCRYPT_KEY.
ENCRYPT_KEY=fina-metrics-2024!

# ── Application ───────────────────────────────────────────────────────────────
# Server port (default 5704)
SERVER_PORT=5704

# Set to true to skip loading dynamic HANA datasources on startup (dev mode)
SKIP_INIT=false

# Log level: DEBUG | INFO | WARN
LOG_LEVEL=INFO
