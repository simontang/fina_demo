# 所有变量都有内置默认值，本地/测试可直接 `pnpm dev` 零配置启动。
# 下面列出的即为当前默认值；生产按需覆盖。

PORT=5708
# 入站 API Key（"key:tenant,..."）。默认用平台签发的 key 映射到 estee_lauder。
GATEWAY_API_KEYS=a2a_f47409c1c94f49ffad37adea3259646f:estee_lauder
AUTH_DISABLED=false
AUTH_DEV_TENANT=estee_lauder

# 本地 platform-service：http://127.0.0.1:5707/api/v1/files
# 线上（经 nginx）：   https://ada.alphafina.cn/api/filesvc
PLATFORM_FILES_URL=http://127.0.0.1:5707/api/v1/files
FILE_SERVICE_API_KEY=
GATEWAY_MAX_UPLOAD_BYTES=52428800
# CORS：默认 "*"（允许任意来源，方便前端联调）；生产建议改为逗号分隔白名单，如 https://app.example.com,https://admin.example.com
GATEWAY_CORS_ORIGINS=*

# Agent 运行派发（消息机制，无 A2A 任务生命周期）
AGENT_RUNS_URL=http://127.0.0.1:5702/api/runs
AGENT_AUTH_URL=http://127.0.0.1:5702/api/auth/login
# 可选：agent AUTH_REQUIRED=true 时填登录凭据；=false 时留空即可（走 x-user-id）。
AGENT_LOGIN_EMAIL=
AGENT_LOGIN_PASSWORD=
AGENT_TENANT_ID=estee_lauder
AGENT_WORKSPACE_ID=default-workspace
AGENT_PROJECT_ID=default
VOICE_TAGGING_ASSISTANT_ID=voice-tagging-agent
VOICE_TAGGING_FILE_UUID=
VOICE_TAGGING_MESSAGE_TEMPLATE=
AGENT_TRIGGER_TIMEOUT_MS=600000

# MCP task 工具（create/get 任务）；默认用平台签发的 key。
MCP_SERVER_URL=http://127.0.0.1:5702/open/mcp
MCP_API_KEY=a2a_f47409c1c94f49ffad37adea3259646f

UPSTREAM_TIMEOUT_MS=30000
