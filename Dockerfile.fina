FROM mcr.microsoft.com/devcontainers/python:3.13

# Install additional dependencies (skip those already in devcontainer image)
RUN apt-get update && apt-get install -y \
    ripgrep \
    chromium \
    && rm -rf /var/lib/apt/lists/*

SHELL ["/bin/bash", "-c"]

# Install pipx and uv
RUN python3 -m pip install --no-cache-dir pipx==1.8.0 && pipx ensurepath && pipx install uv==0.9.26

# Install Python LSP and essential pip packages
RUN python3 -m pip install --no-cache-dir \
    python-lsp-server==1.14.0 \
    matplotlib==3.10.8 \
    pandas==2.2.3 \
    numpy==2.2.6 \
    markitdown

# Devcontainer image already has nvm at /usr/local/share/nvm
# Ensure Node 22.14.0 is installed via nvm
ENV NVM_DIR=/usr/local/share/nvm
ENV NODE_VERSION=22.14.0

RUN [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" \
    && nvm install $NODE_VERSION \
    && nvm alias default $NODE_VERSION \
    && nvm use default

# add node and npm to path so the commands are available
ENV NODE_PATH=$NVM_DIR/versions/node/v$NODE_VERSION/lib/node_modules
ENV PATH=$NVM_DIR/versions/node/v$NODE_VERSION/bin:$PATH

RUN npm install -g ts-node@10.9.2 typescript@5.9.3 typescript-language-server@5.1.3



# Create directory for computer use plugin
RUN mkdir -p /usr/local/lib

# Keep the container running indefinitely
ENTRYPOINT [ "sleep", "infinity" ]
