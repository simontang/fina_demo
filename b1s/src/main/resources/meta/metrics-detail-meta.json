      "time_dimension": "DocDate",
      "label": "Document Date",
      "granularity": "month",
      "window": "current_month",
      "supported_grains": [
        "day",
        "week",
        "month",
        "year"
      ]
    },
    "calculation": {
      "type": "base",
      "sql_expression": "SUM(\"GTotal\")",
      "dependencies": []
    },
    "source": {
      "table_view": "VW_OINV",
      "base_filters": []
    },
    "supported_dimensions": [
      {
        "dim_id": "org_region",
        "field_name": "Region",
        "type": "categorical"
      },
      {
        "dim_id": "sales_person",
        "field_name": "SlpName",
        "type": "categorical"
      },
      {
        "dim_id": "product_category",
        "field_name": "ItmsGrpNam",
        "type": "categorical"
      },
      {
        "dim_id": "customer_group",
        "field_name": "GroupName",
        "type": "categorical"
      }
    ],
    "behavior_profile": {
      "role": "lagging_indicator",
      "analysis_priority": 1
    },
    "ai_agent_context": {
      "synonyms": [
        "Billing Amount",
        "Invoice Amount",
        "Net Revenue",
        "Revenue"
      ],
      "polarity": "positive",
      "thresholds": [
        {
          "metric": "mom_growth",
          "operator": "<",
          "value": -0.1,
          "level": "critical"
        }
      ],
      "diagnostic_workflow": {
        "trigger": {
          "any_of": [
            {
              "metric": "mom_growth",
              "operator": "<",
              "value": -0.1
            }
          ]
        },
        "actions": [
          {
            "type": "compare_metric",
            "metric": "order_amt_tax_inc",
            "intent": "check_backlog_vs_real_decline"
          }
        ],
        "analysis_logic": "billing_vs_booking_gap"
      },
      "human_readable_explanation": "When net sales drop, the system compares with order amount: if orders are stable but billing drops, delivery or invoicing is delayed; if both drop, demand is declining."
    }
  },
  {
    "metric_name": "delivery_qty",
    "display_name": "Delivery Quantity",
