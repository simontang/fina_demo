      "table_view": "VW_ODLN",
      "base_filters": []
    },
    "supported_dimensions": [
      {
        "dim_id": "warehouse",
        "field_name": "WhsName",
        "type": "categorical"
      },
      {
        "dim_id": "product_category",
        "field_name": "ItmsGrpNam",
        "type": "categorical"
      }
    ],
    "behavior_profile": {
      "role": "operational_throughput",
      "analysis_priority": 3
    },
    "ai_agent_context": {
      "synonyms": [
        "Shipped Units",
        "Shipment Qty",
        "Goods Issue Qty",
        "Delivery Volume"
      ],
      "polarity": "positive",
      "thresholds": [
        {
          "metric": "mom_growth",
          "operator": "<",
          "value": -0.1,
          "level": "warning"
