# Remote Agent Gateway this desktop app connects to (no /api suffix).
# Copy to .env and adjust per environment. Resolution order in main.js:
#   process env GATEWAY_URL  >  desktop/.env  >  userData/config.json  >  bundled config.json
# If unset everywhere, /api returns a clear 502 and the app logs a message.
GATEWAY_URL=https://ada.alphafina.cn
