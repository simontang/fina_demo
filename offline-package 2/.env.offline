# ============================================
# Fina Demo 离线版环境变量
# ============================================

# 本地 PostgreSQL 配置（不需要修改，与 docker-compose 中一致）
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fina_db
DB_USER=fina
DB_PASSWORD=fina_local_2024
DATABASE_URL=postgresql://fina:fina_local_2024@postgres:5432/fina_db

# 大模型配置（安装时必须填写）
# LLM_BASE_URL=
# API_KEY3=

# Volcano Engine API 配置（可选，用于 AI 解释和洞察）
# 如需使用，取消注释并填入实际 key
# VOLCENGINE_API_KEY2=
# VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VOLCENGINE_MODEL=kimi-k2-250905

# 日志级别
LOG_LEVEL=INFO
